{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruleloom:schema:candidate:v1",
  "title": "RuleLoom candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "status",
    "engine",
    "engine_version",
    "dataset_hash",
    "config_hash",
    "rules",
    "metrics",
    "baselines",
    "stability",
    "train_ids",
    "test_ids",
    "warnings",
    "metadata",
    "review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^cand-[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["candidate", "shadow", "approved", "rejected", "deprecated"]},
    "engine": {"enum": ["horn", "manual", "popper"]},
    "engine_version": {"type": "string", "minLength": 1},
    "dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rules": {"$ref": "#/$defs/ruleSet"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train": {"$ref": "#/$defs/metrics"},
        "test": {"$ref": "#/$defs/metrics"},
        "historical": {"$ref": "#/$defs/metrics"}
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "never_alert": {"$ref": "#/$defs/metrics"},
        "always_alert": {"$ref": "#/$defs/metrics"},
        "train_majority": {"$ref": "#/$defs/metrics"},
        "best_single_literal": {"$ref": "#/$defs/metrics"}
      }
    },
    "stability": {"type": "number", "minimum": 0, "maximum": 1},
    "train_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/subject"}
    },
    "test_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/subject"}
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "review": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"engine": {"const": "manual"}}, "required": ["engine"]},
      "then": {
        "properties": {
          "metrics": {"required": ["historical"]},
          "baselines": {"required": ["never_alert", "always_alert"]}
        }
      },
      "else": {
        "properties": {
          "metrics": {"required": ["train", "test"]},
          "baselines": {
            "required": ["never_alert", "always_alert", "train_majority", "best_single_literal"]
          }
        }
      }
    }
  ],
  "$defs": {
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "subject": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "negated"],
      "properties": {
        "predicate": {"$ref": "#/$defs/predicate"},
        "negated": {"type": "boolean"}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "body"],
      "properties": {
        "target": {"$ref": "#/$defs/predicate"},
        "body": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/literal"}
        }
      }
    },
    "ruleSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "clauses"],
      "properties": {
        "target": {"$ref": "#/$defs/predicate"},
        "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause"}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "true_positive",
        "false_positive",
        "true_negative",
        "false_negative",
        "precision",
        "recall",
        "f1",
        "accuracy",
        "balanced_accuracy",
        "matthews_correlation",
        "prevalence",
        "predicted_positive_rate"
      ],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "precision": {"type": "number", "minimum": 0, "maximum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1},
        "f1": {"type": "number", "minimum": 0, "maximum": 1},
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "balanced_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "matthews_correlation": {"type": "number", "minimum": -1, "maximum": 1},
        "prevalence": {"type": "number", "minimum": 0, "maximum": 1},
        "predicted_positive_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
