{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruleloom:schema:repository-assertion-manifest:v1",
  "title": "RuleLoom repository assertion manifest v1",
  "description": "Explicit outcome-blind structural expectations accepted by `ruleloom assertions declare`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assertions"],
  "properties": {
    "schema_version": {"const": 1},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/assertion"}
    }
  },
  "$defs": {
    "predicate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate"],
      "properties": {
        "predicate": {"$ref": "#/$defs/predicate"},
        "negated": {"type": "boolean"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "dependentRequired": {
        "start_line": ["end_line"],
        "end_line": ["start_line"]
      },
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!\\.git(?:/|$))(?!\\.ruleloom/)(?!\\.agents/skills/ruleloom/)(?!\\.claude/skills/ruleloom/)(?!.*[\\uD800-\\uDFFF])[^\\u0000-\\u001F\\u007F]*[^/\\u0000-\\u001F\\u007F]$"
        },
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "revision",
        "summary",
        "category",
        "semantics",
        "antecedent",
        "expectation",
        "sources"
      ],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/subject"},
        "revision": {"type": "integer", "minimum": 1},
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "category": {"enum": ["structural", "test_structure"]},
        "semantics": {"const": "antecedent_implies_expectation"},
        "antecedent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/literal"}
        },
        "expectation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/literal"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      }
    }
  },
  "$comment": "The Python model additionally enforces unique assertion identities, canonical literal/source order, distinct predicates within and across antecedent/expectation, ordered source ranges of at most 500 lines, and frozen-vocabulary membership at declaration time."
}
