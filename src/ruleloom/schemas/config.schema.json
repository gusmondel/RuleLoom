{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruleloom:schema:config:v1-v5",
  "title": "RuleLoom configuration v1/v2/v3/v4/v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "target",
    "pack",
    "dataset",
    "candidates_dir",
    "shadow_dir",
    "approved_dir",
    "deprecated_dir",
    "predictions",
    "protocol",
    "learner",
    "evaluation",
    "promotion"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4, 5]},
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][^\\u0000-\\u001f\\u007f]{0,79}$"
    },
    "target": {"$ref": "#/$defs/predicate"},
    "pack": {"$ref": "#/$defs/subject"},
    "pack_version": {"type": "integer", "minimum": 1},
    "pack_config": {"type": "object"},
    "dataset": {"$ref": "#/$defs/path"},
    "candidates_dir": {"$ref": "#/$defs/path"},
    "shadow_dir": {"$ref": "#/$defs/path"},
    "approved_dir": {"$ref": "#/$defs/path"},
    "deprecated_dir": {"$ref": "#/$defs/path"},
    "predictions": {"$ref": "#/$defs/path"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "repository_id",
        "prediction_unit",
        "outcome_definition"
      ],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/subject"},
        "repository_id": {"$ref": "#/$defs/subject"},
        "prediction_unit": {
          "enum": ["git_commit", "git_range", "git_worktree", "provider_change"]
        },
        "outcome_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_paths",
        "exclude_paths",
        "large_change_churn",
        "multi_file_count",
        "metadata_file_limit"
      ],
      "properties": {
        "include_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope"}
        },
        "exclude_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope"}
        },
        "large_change_churn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "multi_file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "metadata_file_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "max_body",
        "max_rules",
        "allow_negation",
        "min_precision",
        "min_support",
        "false_positive_cost",
        "bootstrap_runs",
        "max_predicates",
        "popper_dir",
        "popper_timeout_seconds"
      ],
      "properties": {
        "engine": {"enum": ["horn", "popper"]},
        "max_body": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_rules": {"type": "integer", "minimum": 1, "maximum": 10},
        "allow_negation": {"type": "boolean"},
        "min_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "min_support": {"type": "integer", "minimum": 1},
        "false_positive_cost": {"type": "number", "minimum": 0},
        "bootstrap_runs": {"type": "integer", "minimum": 0, "maximum": 100},
        "max_predicates": {"type": "integer", "minimum": 1, "maximum": 256},
        "popper_dir": {"type": ["string", "null"]},
        "popper_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "gate_mode": {"enum": ["absolute_precision", "relative_lift"]},
        "min_lift_lower_bound": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "min_alert_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "near_miss_limit": {"type": "integer", "minimum": 0, "maximum": 100},
        "search_strategy": {"enum": ["exhaustive", "beam"]},
        "beam_width": {"type": "integer", "minimum": 1, "maximum": 256},
        "predicate_ranking": {"enum": ["rate_gap", "logistic_weight"]},
        "precision_estimate": {"enum": ["point", "wilson_lower"]},
        "require_temporal_consistency": {"type": "boolean"},
        "prune_fraction": {"type": "number", "minimum": 0, "maximum": 0.5},
        "permutation_runs": {"type": "integer", "minimum": 0, "maximum": 1000},
        "tree_seeds": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"engine": {"const": "popper"}},
            "required": ["engine"]
          },
          "then": {
            "properties": {
              "max_rules": {"const": 1},
              "bootstrap_runs": {"const": 0},
              "min_precision": {"const": 0.7},
              "min_support": {"const": 2},
              "false_positive_cost": {"const": 1.5}
            }
          }
        },
        {
          "if": {
            "properties": {"search_strategy": {"const": "beam"}},
            "required": ["search_strategy"]
          },
          "then": {},
          "else": {"properties": {"max_predicates": {"maximum": 32}}}
        }
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_fraction",
        "min_train_examples",
        "min_test_examples",
        "seed"
      ],
      "properties": {
        "test_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "min_train_examples": {"type": "integer", "minimum": 2},
        "min_test_examples": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "test_start_at": {"type": "string", "format": "date-time"}
      }
    },
    "signal_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "folds",
        "min_train_examples",
        "min_validation_examples",
        "min_mcc",
        "min_lift_lower_bound",
        "min_alert_rate",
        "confidence_level",
        "tree_max_depth",
        "max_predicates"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "folds": {"type": "integer", "minimum": 2, "maximum": 20},
        "min_train_examples": {"type": "integer", "minimum": 4},
        "min_validation_examples": {"type": "integer", "minimum": 2},
        "min_mcc": {"type": "number", "minimum": -1, "maximum": 1},
        "min_lift_lower_bound": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "min_alert_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "exclusiveMaximum": 1
        },
        "tree_max_depth": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_predicates": {"type": "integer", "minimum": 1, "maximum": 1024}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_test_precision",
        "min_test_recall",
        "min_stability",
        "require_test_set",
        "min_positive_for_shadow",
        "min_positive_for_approval",
        "require_baseline_improvement",
        "min_shadow_predictions_for_approval",
        "min_shadow_mature_outcomes_for_approval",
        "min_shadow_days_for_approval",
        "min_shadow_precision",
        "min_shadow_recall",
        "min_shadow_mcc",
        "min_shadow_positive_outcomes_for_approval",
        "min_shadow_negative_outcomes_for_approval",
        "min_shadow_matches_per_rule_for_approval"
      ],
      "properties": {
        "min_test_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "min_test_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "min_stability": {"type": "number", "minimum": 0, "maximum": 1},
        "require_test_set": {"type": "boolean"},
        "min_positive_for_shadow": {"type": "integer", "minimum": 1},
        "min_positive_for_approval": {"type": "integer", "minimum": 1},
        "require_baseline_improvement": {"type": "boolean"},
        "min_shadow_predictions_for_approval": {"type": "integer", "minimum": 1},
        "min_shadow_mature_outcomes_for_approval": {
          "type": "integer",
          "minimum": 1
        },
        "min_shadow_days_for_approval": {"type": "integer", "minimum": 0},
        "min_shadow_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "min_shadow_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "min_shadow_mcc": {"type": "number", "minimum": -1, "maximum": 1},
        "min_shadow_positive_outcomes_for_approval": {
          "type": "integer",
          "minimum": 1
        },
        "min_shadow_negative_outcomes_for_approval": {
          "type": "integer",
          "minimum": 1
        },
        "min_shadow_matches_per_rule_for_approval": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_window_days"],
      "properties": {
        "git_window_days": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 3650
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {
        "properties": {"pack": {"const": "flutter_testing"}},
        "not": {
          "anyOf": [
            {"required": ["pack_version"]},
            {"required": ["evidence"]},
            {"required": ["pack_config"]},
            {"required": ["signal_probe"]},
            {
              "properties": {
                "learner": {
                  "anyOf": [
                    {"required": ["gate_mode"]},
                    {"required": ["min_lift_lower_bound"]},
                    {"required": ["min_alert_rate"]},
                    {"required": ["confidence_level"]},
                    {"required": ["near_miss_limit"]},
                    {"required": ["search_strategy"]},
                    {"required": ["beam_width"]},
                    {"required": ["predicate_ranking"]},
                    {"required": ["precision_estimate"]},
                    {"required": ["require_temporal_consistency"]},
                    {"required": ["prune_fraction"]},
                    {"required": ["permutation_runs"]},
                    {"required": ["tree_seeds"]}
                  ]
                }
              }
            },
            {"required": ["outcomes"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "required": ["pack_version", "evidence"],
        "not": {
          "anyOf": [
            {"required": ["pack_config"]},
            {"required": ["signal_probe"]},
            {
              "properties": {
                "learner": {
                  "anyOf": [
                    {"required": ["gate_mode"]},
                    {"required": ["min_lift_lower_bound"]},
                    {"required": ["min_alert_rate"]},
                    {"required": ["confidence_level"]},
                    {"required": ["near_miss_limit"]},
                    {"required": ["search_strategy"]},
                    {"required": ["beam_width"]},
                    {"required": ["predicate_ranking"]},
                    {"required": ["precision_estimate"]},
                    {"required": ["require_temporal_consistency"]},
                    {"required": ["prune_fraction"]},
                    {"required": ["permutation_runs"]},
                    {"required": ["tree_seeds"]}
                  ]
                }
              }
            },
            {"required": ["outcomes"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {
        "required": ["pack_version", "evidence", "pack_config"],
        "not": {
          "anyOf": [
            {"required": ["signal_probe"]},
            {
              "properties": {
                "learner": {
                  "anyOf": [
                    {"required": ["gate_mode"]},
                    {"required": ["min_lift_lower_bound"]},
                    {"required": ["min_alert_rate"]},
                    {"required": ["confidence_level"]},
                    {"required": ["near_miss_limit"]},
                    {"required": ["search_strategy"]},
                    {"required": ["beam_width"]},
                    {"required": ["predicate_ranking"]},
                    {"required": ["precision_estimate"]},
                    {"required": ["require_temporal_consistency"]},
                    {"required": ["prune_fraction"]},
                    {"required": ["permutation_runs"]},
                    {"required": ["tree_seeds"]}
                  ]
                }
              }
            },
            {"required": ["outcomes"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 4}}},
      "then": {
        "required": ["pack_version", "evidence", "pack_config", "signal_probe"],
        "properties": {
          "learner": {
            "required": [
              "gate_mode",
              "min_lift_lower_bound",
              "min_alert_rate",
              "confidence_level",
              "near_miss_limit"
            ],
            "not": {
              "anyOf": [
                {"required": ["search_strategy"]},
                {"required": ["beam_width"]},
                {"required": ["predicate_ranking"]},
                {"required": ["precision_estimate"]},
                {"required": ["require_temporal_consistency"]},
                {"required": ["prune_fraction"]},
                {"required": ["permutation_runs"]},
                {"required": ["tree_seeds"]}
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "signal_probe": {
                  "properties": {"enabled": {"const": true}},
                  "required": ["enabled"]
                }
              }
            },
            "then": {
              "properties": {"evaluation": {"required": ["test_start_at"]}}
            }
          }
        ],
        "not": {"anyOf": [{"required": ["outcomes"]}]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 5}}},
      "then": {
        "required": [
          "pack_version",
          "evidence",
          "pack_config",
          "signal_probe",
          "outcomes"
        ],
        "properties": {
          "learner": {
            "required": [
              "gate_mode",
              "min_lift_lower_bound",
              "min_alert_rate",
              "confidence_level",
              "near_miss_limit",
              "search_strategy",
              "beam_width",
              "predicate_ranking",
              "precision_estimate",
              "require_temporal_consistency",
              "prune_fraction",
              "permutation_runs",
              "tree_seeds"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "signal_probe": {
                  "properties": {"enabled": {"const": true}},
                  "required": ["enabled"]
                }
              }
            },
            "then": {
              "properties": {"evaluation": {"required": ["test_start_at"]}}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"pack": {"const": "configured_paths"}},
        "required": ["pack"]
      },
      "then": {
        "properties": {
          "schema_version": {"enum": [3, 4, 5]},
          "pack_version": {"const": 1},
          "pack_config": {"$ref": "#/$defs/configuredPathsConfig"}
        }
      },
      "else": {
        "if": {
          "properties": {
            "pack": {"const": "generic_changes"},
            "pack_version": {"const": 3}
          },
          "required": ["pack", "pack_version"]
        },
        "then": {
          "properties": {
            "schema_version": {"const": 5},
            "pack_config": {"$ref": "#/$defs/genericChangesV3Config"}
          }
        },
        "else": {
          "properties": {"pack_config": {"type": "object", "maxProperties": 0}}
        }
      }
    }
  ],
  "$defs": {
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "subject": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/|:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\u0000-\u001f\u007f\uD800-\uDFFF]+$"
    },
    "configuredGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/|:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\*\\*[^/]|.*[^/]\\*\\*)(?!.*[\\\\\\[\\]{}\\u0000-\\u001f\\u007f\\uD800-\\uDFFF])[^/]+(?:/[^/]+)*$"
    },
    "pathPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "include_paths", "exclude_paths"],
      "properties": {
        "predicate": {
          "type": "string",
          "minLength": 9,
          "maxLength": 64,
          "pattern": "^touches_[a-z0-9_]+$",
          "not": {
            "enum": [
              "touches_ci",
              "touches_dependencies",
              "touches_docs",
              "touches_test"
            ]
          }
        },
        "include_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/configuredGlob"}
        },
        "exclude_paths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/configuredGlob"}
        }
      }
    },
    "configuredPathsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_predicates"],
      "properties": {
        "path_predicates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pathPredicate"}
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\.ruleloom[\\\\/].+$",
      "allOf": [
        {"not": {"const": "."}},
        {"not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/])"}},
        {"not": {"pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"}}
      ]
    },
    "partnerPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "path", "partner"],
      "properties": {
        "predicate": {
          "type": "string",
          "minLength": 17,
          "maxLength": 64,
          "pattern": "^missing_partner_[a-z0-9_]+$"
        },
        "path": {"$ref": "#/$defs/configuredGlob"},
        "partner": {"$ref": "#/$defs/configuredGlob"}
      }
    },
    "genericChangesV3Config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_predicates": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pathPredicate"}
        },
        "partner_predicates": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/partnerPredicate"}
        }
      }
    }
  }
}
